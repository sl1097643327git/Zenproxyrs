# Zen Proxy RS — environment template
# Copy to .env and fill in your values. Never commit .env to git.

# --- Server ---
PORT=4000
BIND_ADDRESS=0.0.0.0
LOG_LEVEL=info

# --- Upstream (OpenAI-compatible API) ---
UPSTREAM_BASE=https://opencode.ai/zen
UPSTREAM_API_KEY=your-upstream-api-key-here
CHAT_TARGET=/v1/chat/completions
MODEL_TARGET=/v1/models

# --- Client auth (leave PROXY_API_KEY empty to disable) ---
PROXY_API_KEY=sk-your-client-key-here

# --- Admin API (leave empty to disable admin auth) ---
ADMIN_API_KEY=changeme-in-production

# --- Provider mode: legacy | free_model_kernel ---
ZEN_PROVIDER_MODE=legacy

# --- Proxy node pool (optional) ---
# NODES_FILE=/etc/zen-proxy/nodes.json
# PREFERRED_PROXY_URLS=socks5://user:pass@proxy.example.com:1080

# --- Redis (optional, for global budget / session pin) ---
# GLOBAL_BUDGET_REDIS_URL=redis://127.0.0.1:6379/
# CCP_SESSION_PIN_REDIS_URL=redis://127.0.0.1:6379/
# CCP_REASONING_SIDECAR_REDIS_URL=redis://127.0.0.1:6379/

# --- Timeouts ---
CONNECT_TIMEOUT_SECS=5
REQUEST_TIMEOUT_SECS=120
PROBE_TIMEOUT_SECS=30

# --- Request limits ---
REQUEST_BODY_LIMIT_MB=64
V1_MAX_CONCURRENT_REQUESTS=32

# --- Model registry (optional) ---
# V4_MODEL_REGISTRY_ENABLED=false
# DYNAMIC_MODEL_DISCOVERY_ENABLED=false
# DYNAMIC_MODEL_PUBLIC_MODE=static_only

# --- Observability ---
# LEDGER_EVENTS_PATH=/tmp/zen-proxy-ledger-events.jsonl
# AUDIT_LOG_ENABLED=true
# AUDIT_LOG_DIR=/tmp/zen-proxy-audit

# --- Instance identity (auto-generated if unset) ---
# INSTANCE_ID=zen-proxy-1
