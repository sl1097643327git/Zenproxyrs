# Zen Proxy RS — environment template
# Copy to .env and fill in your values. Never commit .env to git.

# --- Server ---
PORT=4000
BIND_ADDRESS=0.0.0.0
LOG_LEVEL=info

# --- Upstream (OpenAI-compatible API) ---
UPSTREAM_BASE=https://opencode.ai/zen
UPSTREAM_API_KEY=your-upstream-api-key-here
CHAT_TARGET=/v1/chat/completions
MODEL_TARGET=/v1/models

# --- Client auth (leave PROXY_API_KEY empty to disable) ---
PROXY_API_KEY=sk-your-client-key-here

# --- Admin API (leave empty to disable admin auth) ---
ADMIN_API_KEY=changeme-in-production

# --- Provider mode: legacy | free_model_kernel ---
ZEN_PROVIDER_MODE=legacy

# --- Clash 订阅地址 (NODE_PROVIDER_MODE=clash 时必填) ---
# 支持 1 或 2 个订阅地址(逗号分隔, 最多 2 个):
#   1 个订阅 -> 两个 mihomo 实例共用该订阅 (各有独立 Selector 组, 节点互不干扰)
#   2 个订阅 -> 实例 A (端口1) 用第一个, 实例 B (端口2) 用第二个 (节点池完全独立)
# SUBSCRIBE_URL=https://your-sub-link-1
# SUBSCRIBE_URL=https://your-sub-link-1,https://your-sub-link-2

# --- Proxy node pool (optional) ---
# NODES_FILE=/etc/zen-proxy/nodes.json
# PREFERRED_PROXY_URLS=socks5://user:pass@proxy.example.com:1080

# --- Node provider mode: webshare (default) | clash ---
# In clash mode the proxy drives Clash instances through their external
# controller API: when a Clash instance is rate-limited/dead, the proxy
# switches to another instance AND asks the failed one to switch to a new
# internal node (with quota), then probes it before putting it back.
# CLASH_API_URLS / CLASH_API_SECRETS / CLASH_PROXY_URLS / CLASH_GROUP_NAMES
# are matched by index: index 0 = first Clash listener (api + local proxy port
# + its Selector group), index 1 = second listener, etc. Each listener may
# drive a DIFFERENT group (e.g. one port bound to "节点选择", another to
# "漏网之鱼"). A single API URL can drive several proxy ports (one GUI.for.Clash
# core with multiple listener ports): the extra ports reuse the last API entry.
# CLASH_GROUP_NAMES is OPTIONAL: when left empty the group names are resolved
# in this order:
#   1. CLASH_CONFIG_FILE (recommended): point it at your mihomo config.yaml
#      (e.g. GUI.for.Clash data/mihomo/config.yaml, Clash Verge, or a bare
#      mihomo config). Its `listeners:` section maps each local port to the
#      CURRENT Selector group, so listener renames are followed automatically
#      and nothing else needs to change when you re-bind ports in the GUI.
#   2. Otherwise the Selector groups exposed by each API are auto-discovered
#      at startup and assigned to listeners by index (GLOBAL and pure built-in
#      groups are skipped).
# The chosen mapping is logged; set CLASH_GROUP_NAMES to pin it explicitly.
# Legacy single CLASH_GROUP_NAME still works as a fallback.
# NODE_PROVIDER_MODE=webshare
# CLASH_API_URLS=http://127.0.0.1:9090,http://127.0.0.1:9091
# CLASH_API_SECRETS=secretA,secretB
# CLASH_PROXY_URLS=socks5://127.0.0.1:7890,socks5://127.0.0.1:7891
# CLASH_GROUP_NAMES=节点选择,漏网之鱼
# CLASH_CONFIG_FILE=F:/Downlods/GUI.for.Clash-windows-amd64/data/mihomo/config.yaml
# CLASH_GROUP_NAME=Proxy
# CLASH_SWITCH_MAX_ATTEMPTS=15
# CLASH_INVALID_TTL_SECS=86400

# --- 5xx circuit-break (上游持续 5xx 自动熔断 & 恢复探测) ---
# 节点连续 N 次 5xx(中间任一成功即清零)触发熔断; 熔断期间不再接真实请求(直接返 5xx)
# 后台以 probe_interval 探测 "1+1", 连续成功 NODE_5XX_PROBE_SUCCESSES 次即解除熔断
# NODE_5XX_BREAK_THRESHOLD=10
# NODE_5XX_BREAK_COOLDOWN_SECS=60
# NODE_5XX_PROBE_INTERVAL_MS=1000
# NODE_5XX_PROBE_SUCCESSES=2

# --- Redis (optional, for global budget / session pin) ---
# GLOBAL_BUDGET_REDIS_URL=redis://127.0.0.1:6379/
# CCP_SESSION_PIN_REDIS_URL=redis://127.0.0.1:6379/
# CCP_REASONING_SIDECAR_REDIS_URL=redis://127.0.0.1:6379/

# --- Timeouts ---
CONNECT_TIMEOUT_SECS=5
REQUEST_TIMEOUT_SECS=120
PROBE_TIMEOUT_SECS=30

# --- Request limits ---
REQUEST_BODY_LIMIT_MB=64
V1_MAX_CONCURRENT_REQUESTS=32

# --- Model registry (optional) ---
# 开启后 /v1/models 显示静态注册表全部模型: deepseek-v4-flash / big-pickle / mimo-v2.5 / hy3
# (关闭时仅硬编码显示 deepseek-v4-flash / deepseek-v4-pro)
# V4_MODEL_REGISTRY_ENABLED=false
# DYNAMIC_MODEL_DISCOVERY_ENABLED=false
# DYNAMIC_MODEL_PUBLIC_MODE=static_only

# --- Observability ---
# LEDGER_EVENTS_PATH=/tmp/zen-proxy-ledger-events.jsonl
# AUDIT_LOG_ENABLED=true
# AUDIT_LOG_DIR=/tmp/zen-proxy-audit

# --- Instance identity (auto-generated if unset) ---
# INSTANCE_ID=zen-proxy-1
